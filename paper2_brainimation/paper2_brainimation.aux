\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Classroom Evaluation of $N = 69$ Undergraduate Student Projects from $N_{\text  {students}} = 30$ Learners in \texttt  {PSYCH 403}.} \textbf  {(A)} Executable Lines of Code (LOC) comparing BrainImation's introductory scaffolds ($N = 36$, median $32\text  { LOC}$) against Student Cohort~1 (Neurofeedback Games \& Art; $N = 40$, median $121\text  { LOC}$), Student Cohort~2 (Online 4-Channel ERP Experiments; $N = 29$, median $176\text  { LOC}$), and per-student median lengths ($N_{\text  {students}} = 30$, median $164\text  { LOC}$, $\text  {IQR} = 122\text  {--}173\text  { LOC}$, Mann--Whitney $U = 1074.0, p < 10^{-11}, r_{rb} = 0.99$). \textbf  {(B)} Percentage of student submissions using signal conditioning ($66.7\%$, $46/69$; Cohort~1: $57.5\%$, Cohort~2: $79.3\%$), alpha ($92.5\%$ of Cohort~1, $53.6\%$ overall), beta ($72.5\%$ of Cohort~1, $42.0\%$ overall), attention ($52.5\%$ of Cohort~1, $34.8\%$ overall), custom object/particle classes ($70.0\%$ of Cohort~1, $20.7\%$ of Cohort~2), online ERP state machines ($100.0\%$ of Cohort~2, $42.0\%$ overall), and 256~Hz raw electrode arrays ($93.1\%$ of Cohort~2, $39.1\%$ overall). \textbf  {(C)} Example Cohort~1 student neurofeedback game (\emph  {Catch 20 Cones}, 195~LOC), showing the falling ice-cream cone sprite, horizontal catcher paddle, score/timer HUD, and bottom alpha/beta target zone indicator bar. \textbf  {(D)} Example Cohort~2 student 4-channel Face vs.\ Object ERP experiment (148~LOC), showing the four color-coded electrode traces (\texttt  {TP9}, \texttt  {AF7}, \texttt  {AF8}, \texttt  {TP10}), real-time condition waveforms, and trial counter.}}{20}{figure.caption.7}\protected@file@percent }
\newlabel{fig:students}{{5}{20}{\textbf {Classroom Evaluation of $N = \NStudentSketches $ Undergraduate Student Projects from $N_{\text {students}} = \NUniqueStudents $ Learners in \texttt {PSYCH 403}.} \textbf {(A)} Executable Lines of Code (LOC) comparing BrainImation's introductory scaffolds ($N = \NBuiltinExamples $, median $\ExLOCMedian \text { LOC}$) against Student Cohort~1 (Neurofeedback Games \& Art; $N = \NStuNF $, median $\StuNFLOCMedian \text { LOC}$), Student Cohort~2 (Online 4-Channel ERP Experiments; $N = \NStuERP $, median $\StuERPLOCMedian \text { LOC}$), and per-student median lengths ($N_{\text {students}} = \NUniqueStudents $, median $\StuClusterLOCMedian \text { LOC}$, $\text {IQR} = \StuClusterLOCIQRLow \text {--}\StuClusterLOCIQRHigh \text { LOC}$, Mann--Whitney $U = \MannWhitneyClusterU , p < 10^{-11}, r_{rb} = \RankBiserialClusterR $). \textbf {(B)} Percentage of student submissions using signal conditioning ($\StuPctCond \%$, $\StuCntCond /\NStudentSketches $; Cohort~1: $\NFPctCond \%$, Cohort~2: $\ERPPctCond \%$), alpha ($\NFPctAlpha \%$ of Cohort~1, $\StuPctAlpha \%$ overall), beta ($\NFPctBeta \%$ of Cohort~1, $\StuPctBeta \%$ overall), attention ($\NFPctAtt \%$ of Cohort~1, $\StuPctAtt \%$ overall), custom object/particle classes ($\NFPctParticles \%$ of Cohort~1, $\ERPPctParticles \%$ of Cohort~2), online ERP state machines ($100.0\%$ of Cohort~2, $\StuPctERP \%$ overall), and 256~Hz raw electrode arrays ($\ERPPctRaw \%$ of Cohort~2, $\StuPctRaw \%$ overall). \textbf {(C)} Example Cohort~1 student neurofeedback game (\emph {Catch 20 Cones}, 195~LOC), showing the falling ice-cream cone sprite, horizontal catcher paddle, score/timer HUD, and bottom alpha/beta target zone indicator bar. \textbf {(D)} Example Cohort~2 student 4-channel Face vs.\ Object ERP experiment (148~LOC), showing the four color-coded electrode traces (\texttt {TP9}, \texttt {AF7}, \texttt {AF8}, \texttt {TP10}), real-time condition waveforms, and trial counter}{figure.caption.7}{}}
