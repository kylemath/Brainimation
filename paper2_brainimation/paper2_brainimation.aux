\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Teaching Modules for Audio Sonification, Online 4-Channel ERP Averaging, and Signal Smoothing.} \textbf  {(A)} Audio waveforms from \texttt  {brainSynth.js} comparing a relaxed high-alpha state ($650\text  { Hz}$ smooth tone) against an active high-beta/theta state (frequency-modulated waveform). \textbf  {(B)} Corresponding audio frequency spectra (\texttt  {p5.FFT}) showing a single dominant frequency during relaxation versus harmonic sidebands during active engagement. \textbf  {(C)} Online 256~Hz ERP trial averaging in \texttt  {epochs.js} ($-200\text  { to }+800\text  { ms}$, positive-up voltage convention in $\mu \text  {V}$, baseline-corrected over $-200\text  { to }0\text  { ms}$; \citealp  {picton2000guidelines,keil2014committee}) across $K = 1, 5,$ and $20$ trials. Here, \texttt  {EEGSimulator} injects canonical textbook polarities ($-6.5\ \mu \text  {V}$ N170 at $+170\text  { ms}$, $+9.5\ \mu \text  {V}$ P300 at $+340\text  { ms}$) directly onto simulated channel \texttt  {TP9} so beginners first recognize standard component morphology; by contrast, physical headband recordings measure $V_{\text  {channel}} - V_{\text  {Fpz}}$, which inverts vertex/parietal oddball dipoles unless re-referenced against frontal electrodes (\citealp  {krigolson2017choosing}). \textbf  {(D)} Exponential moving-average smoothing and dual-threshold hysteresis used in student neurofeedback games to prevent rapid on/off flicker.}}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:sonification}{{3}{8}{\textbf {Teaching Modules for Audio Sonification, Online 4-Channel ERP Averaging, and Signal Smoothing.} \textbf {(A)} Audio waveforms from \texttt {brainSynth.js} comparing a relaxed high-alpha state ($650\text { Hz}$ smooth tone) against an active high-beta/theta state (frequency-modulated waveform). \textbf {(B)} Corresponding audio frequency spectra (\texttt {p5.FFT}) showing a single dominant frequency during relaxation versus harmonic sidebands during active engagement. \textbf {(C)} Online 256~Hz ERP trial averaging in \texttt {epochs.js} ($-200\text { to }+800\text { ms}$, positive-up voltage convention in $\mu \text {V}$, baseline-corrected over $-200\text { to }0\text { ms}$; \citealp {picton2000guidelines,keil2014committee}) across $K = 1, 5,$ and $20$ trials. Here, \texttt {EEGSimulator} injects canonical textbook polarities ($-6.5\ \mu \text {V}$ N170 at $+170\text { ms}$, $+9.5\ \mu \text {V}$ P300 at $+340\text { ms}$) directly onto simulated channel \texttt {TP9} so beginners first recognize standard component morphology; by contrast, physical headband recordings measure $V_{\text {channel}} - V_{\text {Fpz}}$, which inverts vertex/parietal oddball dipoles unless re-referenced against frontal electrodes (\citealp {krigolson2017choosing}). \textbf {(D)} Exponential moving-average smoothing and dual-threshold hysteresis used in student neurofeedback games to prevent rapid on/off flicker}{figure.caption.4}{}}
