\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Teaching Modules for Optical fNIRS Short-Channel Skin Regression and 6-DOF IMU Motion Filtering.} \textbf  {(A)} Simulated dual-distance ($8\text  { mm}$ short channel vs.\ $20\text  { mm}$ long channel) optical blood-flow traces, showing how subtracting the scaled $8\text  { mm}$ superficial skin signal removes heart-pulse ($1.18\text  { Hz}$), breathing ($0.26\text  { Hz}$), and Mayer-wave ($0.10\text  { Hz}$) contamination ($20.1\text  { dB}$ reduction; $\text  {RMSE}: 1.15\rightarrow 0.11\ \mu \text  {M}$ [$1.147\rightarrow 0.113\ \mu \text  {M}$ unrounded], $r: 0.46\rightarrow 0.99$). \textbf  {(B)} Resulting prefrontal oxyhemoglobin ($\Delta [\text  {HbO}_2]$), deoxyhemoglobin ($\Delta [\text  {HHb}]$), and total hemoglobin ($\Delta [\text  {HbT}]$) response during a simulated task block ($4\text  {--}14\text  { s}$). \textbf  {(C)} 52~Hz 6-DOF IMU head tilt angle (\texttt  {pitch}, peak $\pm 16^{\circ }$), gravity-removed linear acceleration (peak $\pm 1.4\text  { m/s}^2$), 1st-order head velocity ($\text  {cm/s}$), and 2nd-order 3D head displacement ($\text  {cm}$), each normalized to unit peak amplitude ($[-1, 1]$) for joint comparison. \textbf  {(D)} Adaptive 6-tap NLMS filtering of simulated head-movement artifacts on frontal EEG (\texttt  {AF7}), reducing motion artifact by $19.2\text  { dB}$ ($\text  {RMSE}: 43.7\rightarrow 4.8\ \mu \text  {V}$, $r: 0.31\rightarrow 0.95$).}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:multimodal}{{4}{11}{\textbf {Teaching Modules for Optical fNIRS Short-Channel Skin Regression and 6-DOF IMU Motion Filtering.} \textbf {(A)} Simulated dual-distance ($8\text { mm}$ short channel vs.\ $20\text { mm}$ long channel) optical blood-flow traces, showing how subtracting the scaled $8\text { mm}$ superficial skin signal removes heart-pulse ($1.18\text { Hz}$), breathing ($0.26\text { Hz}$), and Mayer-wave ($0.10\text { Hz}$) contamination ($\FNIRSSuppDB \text { dB}$ reduction; $\text {RMSE}: \FNIRSErrRawUM \rightarrow \FNIRSErrCleanUM \ \mu \text {M}$ [$\FNIRSErrRawUMThreeD \rightarrow \FNIRSErrCleanUMThreeD \ \mu \text {M}$ unrounded], $r: \FNIRSRRaw \rightarrow \FNIRSRClean $). \textbf {(B)} Resulting prefrontal oxyhemoglobin ($\Delta [\text {HbO}_2]$), deoxyhemoglobin ($\Delta [\text {HHb}]$), and total hemoglobin ($\Delta [\text {HbT}]$) response during a simulated task block ($4\text {--}14\text { s}$). \textbf {(C)} 52~Hz 6-DOF IMU head tilt angle (\texttt {pitch}, peak $\pm 16^{\circ }$), gravity-removed linear acceleration (peak $\pm 1.4\text { m/s}^2$), 1st-order head velocity ($\text {cm/s}$), and 2nd-order 3D head displacement ($\text {cm}$), each normalized to unit peak amplitude ($[-1, 1]$) for joint comparison. \textbf {(D)} Adaptive 6-tap NLMS filtering of simulated head-movement artifacts on frontal EEG (\texttt {AF7}), reducing motion artifact by $\NLMSSuppDB \text { dB}$ ($\text {RMSE}: \NLMSRMSERawUV \rightarrow \NLMSRMSECleanUV \ \mu \text {V}$, $r: \NLMSRRaw \rightarrow \NLMSRClean $)}{figure.caption.5}{}}
