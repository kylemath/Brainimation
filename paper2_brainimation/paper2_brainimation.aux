\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Classroom Evaluation of $N = 69$ Undergraduate Student Projects from $N_{\text  {students}} = 30$ Learners in \texttt  {PSYCH 403}.} \textbf  {(A)} Executable Lines of Code (LOC) comparing BrainImation's introductory scaffolds ($N = 37$, median $32\text  { LOC}$) against Student Cohort~1 (Neurofeedback Games \& Art; $N = 40$, median $121\text  { LOC}$), Student Cohort~2 (Online 4-Channel ERP Experiments; $N = 29$, median $176\text  { LOC}$), and per-student median lengths ($N_{\text  {students}} = 30$, median $164\text  { LOC}$, $p < 10^{-11}$). \textbf  {(B)} Percentage of student submissions using signal smoothing, EEG bands, raw ERP buffers, and interactive \texttt  {p5.js} features. \textbf  {(C)} Example Cohort~1 student neurofeedback game (\emph  {Catch 20 Cones}, 195~LOC), showing the falling ice-cream cone sprite, horizontal catcher paddle, score/timer HUD, and bottom alpha/beta target zone indicator bar. \textbf  {(D)} Example Cohort~2 student 4-channel Face vs.\ Object ERP experiment (148~LOC), showing the four color-coded electrode traces (\texttt  {TP9}, \texttt  {AF7}, \texttt  {AF8}, \texttt  {TP10}), real-time condition waveforms, and trial counter.}}{13}{figure.caption.6}\protected@file@percent }
\newlabel{fig:students}{{5}{13}{\textbf {Classroom Evaluation of $N = \NStudentSketches $ Undergraduate Student Projects from $N_{\text {students}} = \NUniqueStudents $ Learners in \texttt {PSYCH 403}.} \textbf {(A)} Executable Lines of Code (LOC) comparing BrainImation's introductory scaffolds ($N = \NBuiltinExamples $, median $\ExLOCMedian \text { LOC}$) against Student Cohort~1 (Neurofeedback Games \& Art; $N = \NStuNF $, median $\StuNFLOCMedian \text { LOC}$), Student Cohort~2 (Online 4-Channel ERP Experiments; $N = \NStuERP $, median $\StuERPLOCMedian \text { LOC}$), and per-student median lengths ($N_{\text {students}} = \NUniqueStudents $, median $\StuClusterLOCMedian \text { LOC}$, $p < 10^{-11}$). \textbf {(B)} Percentage of student submissions using signal smoothing, EEG bands, raw ERP buffers, and interactive \texttt {p5.js} features. \textbf {(C)} Example Cohort~1 student neurofeedback game (\emph {Catch 20 Cones}, 195~LOC), showing the falling ice-cream cone sprite, horizontal catcher paddle, score/timer HUD, and bottom alpha/beta target zone indicator bar. \textbf {(D)} Example Cohort~2 student 4-channel Face vs.\ Object ERP experiment (148~LOC), showing the four color-coded electrode traces (\texttt {TP9}, \texttt {AF7}, \texttt {AF8}, \texttt {TP10}), real-time condition waveforms, and trial counter}{figure.caption.6}{}}
