\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Classroom Coding Supports, Hardware-Free Simulation, and 21-Category Visual Catalogue Profile ($N = 234$ Sketches).} \textbf  {(A)} Distribution of the 153\ click-to-insert API entries across 30\ groups and 5\ reference tabs (\emph  {Sensors / IMU \& PPG}: 53; \emph  {P5.js}: 38; \emph  {Input}: 27; \emph  {EEG Data}: 19; \emph  {Sound}: 16). \textbf  {(B)} Two-second 4-channel simulated 256~Hz EEG traces showing ongoing oscillations and synchronous frontal eye blinks (\texttt  {TP9}, \texttt  {AF7}, \texttt  {AF8}, \texttt  {TP10} in \texttt  {EEGSimulator}). \textbf  {(C)} Executable lines of code across the 21\ categories in the Visual Catalogue ($N = 234$ sketches, overall $\text  {median} = 110\text  { LOC}$, range $11\text  {--}1438\text  { LOC}$; bars show category median and lines span min--max range). \textbf  {(D)} Percentage of the 234\ catalogue sketches demonstrating each sensor and multimedia capability: alpha ($56.4\%$, $132/234$), beta ($41.0\%$, $96/234$), attention ($32.5\%$, $76/234$), theta ($32.1\%$, $75/234$), 256~Hz raw/ERP buffers ($18.8\%$, $44/234$), 52~Hz IMU motion ($16.7\%$, $39/234$), 64~Hz optical PPG/fNIRS ($8.1\%$, $19/234$), and Web Audio synthesis ($7.7\%$, $18/234$).}}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig:scaffolding}{{2}{10}{\textbf {Classroom Coding Supports, Hardware-Free Simulation, and \NCatalogueCategories -Category Visual Catalogue Profile ($N = \NCatalogueSketches $ Sketches).} \textbf {(A)} Distribution of the \NRefAPIs \ click-to-insert API entries across \NRefGroups \ groups and \NRefTabs \ reference tabs (\emph {Sensors / IMU \& PPG}: \NRefSensors ; \emph {P5.js}: \NRefPFive ; \emph {Input}: \NRefInput ; \emph {EEG Data}: \NRefEEGData ; \emph {Sound}: \NRefSound ). \textbf {(B)} Two-second 4-channel simulated 256~Hz EEG traces showing ongoing oscillations and synchronous frontal eye blinks (\texttt {TP9}, \texttt {AF7}, \texttt {AF8}, \texttt {TP10} in \texttt {EEGSimulator}). \textbf {(C)} Executable lines of code across the \NCatalogueCategories \ categories in the Visual Catalogue ($N = \NCatalogueSketches $ sketches, overall $\text {median} = \CatLOCMedian \text { LOC}$, range $\CatLOCMin \text {--}\CatLOCMax \text { LOC}$; bars show category median and lines span min--max range). \textbf {(D)} Percentage of the \NCatalogueSketches \ catalogue sketches demonstrating each sensor and multimedia capability: alpha ($\CatPctAlpha \%$, $\CatCntAlpha /\NCatalogueSketches $), beta ($\CatPctBeta \%$, $\CatCntBeta /\NCatalogueSketches $), attention ($\CatPctAtt \%$, $\CatCntAtt /\NCatalogueSketches $), theta ($\CatPctTheta \%$, $\CatCntTheta /\NCatalogueSketches $), 256~Hz raw/ERP buffers ($\CatPctRaw \%$, $\CatCntRaw /\NCatalogueSketches $), 52~Hz IMU motion ($\CatPctIMU \%$, $\CatCntIMU /\NCatalogueSketches $), 64~Hz optical PPG/fNIRS ($\CatPctPPG \%$, $\CatCntPPG /\NCatalogueSketches $), and Web Audio synthesis ($\CatPctAudio \%$, $\CatCntAudio /\NCatalogueSketches $)}{figure.caption.4}{}}
